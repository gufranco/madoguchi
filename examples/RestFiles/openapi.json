{
  "openapi": "3.1.0",
  "info": {
    "title": "Madoguchi SD files",
    "version": "1.0.0",
    "description": "Lists, downloads, uploads and deletes files in the root folder of the SD card. Names are 1 to 64 printable ASCII characters, such as holiday photo.jpeg. Listing and downloading are public; uploading and deleting need a bearer token from POST /api/auth/login, valid for 15 minutes and until the board restarts."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-mado-limits": {
    "outputBufferSize": 512,
    "fileChunkSize": 512
  },
  "components": {
    "schemas": {
      "FileEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "directory"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "directory": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 16
          },
          "password": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "maxLength": 200
          },
          "token_type": {
            "type": "string",
            "maxLength": 6
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Exchange credentials for a bearer token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or missing body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Wrong user name or password"
          },
          "413": {
            "description": "The body is larger than this operation accepts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "A field is missing, unknown or too long",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Five failures in a row lock login for 15 minutes"
          },
          "503": {
            "description": "The board has no signing key yet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/files": {
      "get": {
        "operationId": "listFiles",
        "summary": "List the files in the card's root folder",
        "responses": {
          "200": {
            "description": "Up to 32 entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileEntry"
                  }
                }
              }
            }
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{name}": {
      "parameters": [
        {
          "name": "name",
          "in": "path",
          "required": true,
          "description": "A file name of 1 to 64 printable ASCII characters",
          "schema": {
            "type": "string",
            "maxLength": 64
          }
        }
      ],
      "get": {
        "operationId": "getFile",
        "summary": "Download a file, whole or one byte range",
        "parameters": [
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "One range, such as bytes=0-1023"
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A tag from an earlier download; the board's tags are weak, so the whole file is sent"
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "description": "1 asks the browser to save the file"
          }
        ],
        "responses": {
          "200": {
            "description": "The whole file",
            "content": {
              "application/octet-stream": {}
            }
          },
          "206": {
            "description": "One byte range",
            "content": {
              "application/octet-stream": {}
            }
          },
          "304": {
            "description": "The copy the client holds is current"
          },
          "400": {
            "description": "The name is not a valid file name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No file has this name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "416": {
            "description": "The range starts past the end of the file"
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putFile",
        "summary": "Create or replace a file",
        "parameters": [
          {
            "name": "Repr-Digest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "sha-256=:<base64>: of the body; the upload is refused without it"
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The strong ETag from a GET; the replace is refused with 412 when the file changed since"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; Location names the file"
          },
          "204": {
            "description": "Replaced"
          },
          "400": {
            "description": "The name is not a valid file name, Repr-Digest is missing, or the body ended early",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "If-Match names a tag the file no longer has, or the file does not exist",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than the board accepts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The body does not match Repr-Digest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "507": {
            "description": "The card refused the write",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No bearer token, or one that is malformed, wrongly signed, from an earlier boot or older than 15 minutes",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "operationId": "deleteFile",
        "summary": "Delete a file",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "The name is not a valid file name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No file has this name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No bearer token, or one that is malformed, wrongly signed, from an earlier boot or older than 15 minutes",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  }
}
