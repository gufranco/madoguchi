{
  "openapi": "3.1.0",
  "info": {
    "title": "Madoguchi SD files",
    "version": "1.0.0",
    "description": "Lists, downloads, uploads and deletes files in the root folder of the SD card. Names are 8.3, such as LOG.TXT. This example has no login: add the one from RestAuth before the board is reachable from an untrusted network."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-mado-limits": {
    "outputBufferSize": 512,
    "fileChunkSize": 512
  },
  "components": {
    "schemas": {
      "FileEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "directory"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 12
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "directory": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  },
  "paths": {
    "/api/files": {
      "get": {
        "operationId": "listFiles",
        "summary": "List the files in the card's root folder",
        "responses": {
          "200": {
            "description": "Up to 32 entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileEntry"
                  }
                }
              }
            }
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{name}": {
      "parameters": [
        {
          "name": "name",
          "in": "path",
          "required": true,
          "description": "An 8.3 file name",
          "schema": {
            "type": "string",
            "maxLength": 12
          }
        }
      ],
      "get": {
        "operationId": "getFile",
        "summary": "Download a file, whole or one byte range",
        "parameters": [
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "One range, such as bytes=0-1023"
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A tag from an earlier download; the board's tags are weak, so the whole file is sent"
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "description": "1 asks the browser to save the file"
          }
        ],
        "responses": {
          "200": {
            "description": "The whole file",
            "content": {
              "application/octet-stream": {}
            }
          },
          "206": {
            "description": "One byte range",
            "content": {
              "application/octet-stream": {}
            }
          },
          "304": {
            "description": "The copy the client holds is current"
          },
          "400": {
            "description": "The name is not an 8.3 name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No file has this name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "416": {
            "description": "The range starts past the end of the file"
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putFile",
        "summary": "Create or replace a file",
        "parameters": [
          {
            "name": "Repr-Digest",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "sha-256=:<base64>: checked against the body"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; Location names the file"
          },
          "204": {
            "description": "Replaced"
          },
          "400": {
            "description": "The name is not an 8.3 name, or the body ended early",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than the board accepts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The body does not match Repr-Digest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "507": {
            "description": "The card refused the write",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteFile",
        "summary": "Delete a file",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "The name is not an 8.3 name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No file has this name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The SD card is missing or unreadable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  }
}
