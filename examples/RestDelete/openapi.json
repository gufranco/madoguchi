{
  "openapi": "3.1.0",
  "info": {
    "title": "Madoguchi DELETE example",
    "version": "1.0.0",
    "description": "Deletes one of two items the board seeds at start."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "on"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 16
          },
          "on": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  },
  "paths": {
    "/api/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254
          }
        }
      ],
      "delete": {
        "operationId": "deleteItem",
        "summary": "Delete an item",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "No item with this id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  }
}
