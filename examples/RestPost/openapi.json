{
  "openapi": "3.1.0",
  "info": {
    "title": "Madoguchi POST example",
    "version": "1.0.0",
    "description": "Creates items in RAM; the table holds four."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "on"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 16
          },
          "on": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  },
  "paths": {
    "/api/items": {
      "post": {
        "operationId": "createItem",
        "summary": "Create an item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Item"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or missing body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than this operation accepts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "A field is missing, unknown, too long or of the wrong type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "507": {
            "description": "Every slot is taken",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  }
}
